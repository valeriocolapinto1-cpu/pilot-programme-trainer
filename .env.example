# AI configuration — copy to .env.local for local dev, or set these as
# Environment Variables in Vercel (Project → Settings → Environment Variables).
# Without a key the app still works: quizzes come from the built-in bank and the
# group chat falls back to CRM self-assessment.

# Which provider to use: "anthropic" (default) or "openai".
AI_PROVIDER=anthropic

# Your API key. You can also use ANTHROPIC_API_KEY or OPENAI_API_KEY instead.
AI_API_KEY=

# Optional model override.
#   Anthropic default: claude-3-5-sonnet-latest  (set a newer snapshot if you have it)
#   OpenAI default:    gpt-4o
# AI_MODEL=
