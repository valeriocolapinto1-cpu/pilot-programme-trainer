{
  "name": "pilot-programme-trainer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Trainer for the Wizz Air Pathway Programme (Urbe Aero) ab-initio pilot selection",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
